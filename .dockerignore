# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.

# ── Build outputs / local cruft ──────────────────────────────────────────────
# The COPY boundary separates source from artifacts. build.sh produces its outputs
# under /mayhem at build time (mayhem-build/, the linked binaries).
build/
out/
external/
mayhem-build/
mayhem-tests/
*.o
*.a
*.so
*.dylib
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
